# Local dev — copy to .env and fill in values
NODE_ENV=development
PORT=3000

# Database (local Docker)
DATABASE_URL="postgresql://upstack:upstack@localhost:5432/upstack_dev"

# Redis (local Docker)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-this-to-a-random-32-char-string"
JWT_EXPIRES_IN="7d"

# Email (Resend)
RESEND_API_KEY="re_your_key_here"
RESEND_FROM_EMAIL="alerts@upstack.io"

# Stripe
STRIPE_SECRET_KEY="sk_test_your_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_secret_here"
STRIPE_PRO_PRICE_ID="price_your_price_id"

# App
FRONTEND_URL="http://localhost:5173"
CHECK_ENGINE_ENABLED=true
MAX_CONCURRENT_CHECKS=5
