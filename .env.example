# ──────────────────────────────────────────────────────────────────────────────
# Upstack API — Environment Variables
# Copy this file to .env and fill in every value before starting the server.
# NEVER commit your .env file to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production | test
PORT=3000                     # Port the HTTP server listens on

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Local Docker default (see docker-compose.yml):
DATABASE_URL="postgresql://upstack:upstack@localhost:5432/upstack_dev"

# ─── Redis ───────────────────────────────────────────────────────────────────
# Used by BullMQ job queues for the check engine.
# Local Docker default:
REDIS_URL="redis://localhost:6379"

# ─── Authentication ──────────────────────────────────────────────────────────
# JWT secret — must be at least 16 characters. Use a long random string.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-this-to-a-random-32-char-string"
JWT_EXPIRES_IN="7d"           # e.g. 7d, 24h, 60m

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Obtain your API key from https://resend.com
RESEND_API_KEY="re_your_key_here"
# Sender address — must be a verified domain in your Resend account
RESEND_FROM_EMAIL="alerts@upstack.io"

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Secret key from https://dashboard.stripe.com/apikeys
# Use sk_test_... for development, sk_live_... for production
STRIPE_SECRET_KEY="sk_test_your_key_here"

# Webhook signing secret — from https://dashboard.stripe.com/webhooks
# (or `stripe listen --print-secret` for local dev with the Stripe CLI)
STRIPE_WEBHOOK_SECRET="whsec_your_secret_here"

# Stripe Price ID for the PRO plan subscription
STRIPE_PRO_PRICE_ID="price_your_price_id"

# ─── Application ─────────────────────────────────────────────────────────────
# URL of the frontend app — used for Stripe redirect URLs and CORS origin
FRONTEND_URL="http://localhost:5173"

# Set to false to disable the background check engine (useful for testing)
CHECK_ENGINE_ENABLED=true

# Maximum number of monitor checks to run in parallel
MAX_CONCURRENT_CHECKS=5
